[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/options/options_menu.gd" id="1_options"]

[node name="Options" type="VBoxContainer"]
theme_override_constants/separation = 10
script = ExtResource("1_options")

[node name="Header" type="Label" parent="."]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.1, 0.75, 1)
theme_override_font_sizes/font_size = 24
text = "> OPTIONEN"

[node name="Tabs" type="TabContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
current_tab = 0
use_hidden_tabs_for_min_size = true

[node name="GRAFIK" type="VBoxContainer" parent="Tabs"]
layout_mode = 2
theme_override_constants/separation = 10
metadata/_tab_index = 0

[node name="FullscreenCheck" type="CheckButton" parent="Tabs/GRAFIK"]
unique_name_in_owner = true
layout_mode = 2
text = "Vollbild"

[node name="ResolutionRow" type="HBoxContainer" parent="Tabs/GRAFIK"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="ResolutionLabel" type="Label" parent="Tabs/GRAFIK/ResolutionRow"]
custom_minimum_size = Vector2(160, 0)
layout_mode = 2
text = "Auflösung"

[node name="ResolutionOption" type="OptionButton" parent="Tabs/GRAFIK/ResolutionRow"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Fenster: Fenstergröße. Vollbild: Auflösung der 3D-Welt (Monitor = volle Schärfe, kleiner = mehr FPS). Menüs bleiben immer scharf."
size_flags_horizontal = 3

[node name="VsyncCheck" type="CheckButton" parent="Tabs/GRAFIK"]
unique_name_in_owner = true
layout_mode = 2
text = "VSync"

[node name="MsaaRow" type="HBoxContainer" parent="Tabs/GRAFIK"]
